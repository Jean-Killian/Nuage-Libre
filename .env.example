# Copy this file to .env and replace every "change-me" with a strong password:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# --- PostgreSQL container (used by compose.yaml / db/init) ---
POSTGRES_PASSWORD=change-me
NUAGE_OWNER_PASSWORD=change-me
NUAGE_APP_PASSWORD=change-me

# --- FastAPI application (read by app/config.py) ---
NUAGE_DATABASE_URL=postgresql+asyncpg://nuage_app:change-me@127.0.0.1:5432/nuage_libre
NUAGE_MIGRATION_DATABASE_URL=postgresql+asyncpg://nuage_owner:change-me@127.0.0.1:5432/nuage_libre
# Used by the automated tests (tests/conftest.py)
NUAGE_TEST_DATABASE_URL=postgresql+asyncpg://nuage_app:change-me@127.0.0.1:5432/nuage_libre_test
NUAGE_TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://nuage_owner:change-me@127.0.0.1:5432/nuage_libre_test

# --- Private cloud (optional: these are the defaults) ---
# Absolute path of the folder holding the uploaded files (created on first upload).
# NUAGE_STORAGE_DIR=/var/mnt/Lexar2To/data_nuage_libre/cloud_storage
# Largest accepted upload, and free space that must remain on the disk (bytes).
# NUAGE_MAX_UPLOAD_BYTES=2147483648
# NUAGE_MIN_FREE_DISK_BYTES=2147483648
